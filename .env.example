# Copy to .env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://goodnews:goodnews@localhost:5432/goodnews
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
INGESTION_USER_AGENT=GoodNewsBot/0.1 (+https://example.org/bot; contact: you@example.org)
ARTICLE_MAX_AGE_DAYS=14
# LLM enrichment is OFF by default (Phase 7). Do not enable at launch.
LLM_ENRICHMENT_ENABLED=0
LLM_PROVIDER=
LLM_API_KEY=
LLM_DAILY_BUDGET_USD=0
# Flutter reads this via --dart-define=API_BASE_URL=...
API_BASE_URL=http://localhost:8000/api/v1
# Origins allowed by the API (CORS): local dev + GitHub Pages
CORS_ALLOWED_ORIGINS=http://localhost:5000,https://<user>.github.io
