  "fixed_sql": [
    {
      "name": "sources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sources\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"homepage_url\" TEXT NOT NULL, \"rss_url\" TEXT NOT NULL, \"tier\" INTEGER NOT NULL, \"trust_score\" REAL NOT NULL, \"language\" TEXT NOT NULL, \"regions\" TEXT NOT NULL, \"user_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"user_enabled\" IN (0, 1)), \"etag\" TEXT NOT NULL DEFAULT '', \"last_modified\" TEXT NOT NULL DEFAULT '', \"last_fetched_at\" INTEGER NULL, \"last_status\" TEXT NULL, \"consecutive_failures\" INTEGER NOT NULL DEFAULT 0, \"backoff_until\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "articles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"articles\" (\"id\" TEXT NOT NULL, \"source_id\" TEXT NOT NULL REFERENCES sources (id), \"canonical_url\" TEXT NOT NULL UNIQUE, \"title\" TEXT NOT NULL, \"excerpt\" TEXT NOT NULL, \"published_at\" INTEGER NOT NULL, \"fetched_at\" INTEGER NOT NULL, \"language\" TEXT NOT NULL, \"regions\" TEXT NOT NULL, \"topics\" TEXT NOT NULL, \"story_types\" TEXT NOT NULL DEFAULT '[]', \"evidence_signals\" TEXT NOT NULL DEFAULT '[]', \"constructive_score\" REAL NULL, \"route\" TEXT NULL, \"explanation\" TEXT NULL, \"rules_version\" TEXT NULL, \"cluster_id\" TEXT NULL, \"hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (\"hidden\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "daily_picks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_picks\" (\"day\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"article_id\" TEXT NOT NULL REFERENCES articles (id) ON DELETE CASCADE, PRIMARY KEY (\"day\", \"position\"));"
        }
      ]
    },
    {
      "name": "seen",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"seen\" (\"article_id\" TEXT NOT NULL REFERENCES articles (id) ON DELETE CASCADE, \"seen_at\" INTEGER NOT NULL, PRIMARY KEY (\"article_id\"));"
        }
      ]
    },
    {
      "name": "preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"preferences\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "bookmarks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookmarks\" (\"article_id\" TEXT NOT NULL, \"saved_at\" INTEGER NOT NULL, \"snapshot\" TEXT NOT NULL, PRIMARY KEY (\"article_id\"));"
        }
      ]
    },
    {
      "name": "articles_route_published",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX articles_route_published ON articles (route, published_at)"
        }
      ]
    }
  ]
