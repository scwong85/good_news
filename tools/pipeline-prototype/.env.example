# Copy to .env if you want to override defaults. Never commit real secrets.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DATABASE_URL=postgres://goodnews:goodnews@localhost:5432/goodnews
# Identify the fetcher politely; use a real contact URL when running regularly.
INGESTION_USER_AGENT=GoodNewsBot/0.1 (+https://example.org/bot)
ARTICLE_MAX_AGE_DAYS=14
